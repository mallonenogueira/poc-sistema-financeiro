{
  "mappings": [
    {
      "name": "Nega transferências acima de R$ 10.000",
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/v1/fraud/evaluations",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.amount > 10000)]" }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "decision": "DENIED", "score": 92, "reason": "Valor acima do padrão transacional do cliente" }
      }
    },
    {
      "name": "Simula lentidão quando o valor é 666,99 (demonstra timeout + circuit breaker)",
      "priority": 2,
      "request": {
        "method": "POST",
        "url": "/v1/fraud/evaluations",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.amount == 666.99)]" }]
      },
      "response": {
        "status": 200,
        "fixedDelayMilliseconds": 5000,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "decision": "APPROVED", "score": 5 }
      }
    },
    {
      "name": "Aprova o restante",
      "priority": 10,
      "request": { "method": "POST", "url": "/v1/fraud/evaluations" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "decision": "APPROVED", "score": 8 }
      }
    }
  ]
}
